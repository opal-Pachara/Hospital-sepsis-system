# ═════════════════════════════════════════════════════════════════════════════
# RTSAS Environment Variables — Copy this file to .env and configure
# ═════════════════════════════════════════════════════════════════════════════

# ── JWT Authentication ───────────────────────────────────────────────────────
# คำเตือน: กรุณาเปลี่ยนเป็นสตริงสุ่มที่มีความปลอดภัยสูงก่อนนำขึ้น Production
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY_rtsas_secret_2026
JWT_EXPIRE_HOURS=8   # 8 ชั่วโมง = 1 กะการทำงานของพยาบาล/แพทย์

# ── Auth DB (MySQL 8 ใน Docker container: rtsas_auth_db) ──────────────────────
AUTH_DB_ROOT_PASSWORD=rtsas_root_secure
AUTH_DB_PASSWORD=rtsas_secure

# ── HOSxP MySQL Database ─────────────────────────────────────────────────────
# 1. สำหรับ Production (ต่อ HOSxP ผ่าน LAN โรงพยาบาล):
#    DB_HOST=192.168.2.230
# 2. สำหรับทดสอบ Docker บนเครื่องตนเอง (ต่อ MySQL บน localhost ของเครื่อง host):
#    DB_HOST=host.docker.internal
# 3. สำหรับรัน Local Backend โดยตรง (ไม่ผ่าน Docker):
#    DB_HOST=127.0.0.1
DB_HOST=192.168.2.230
DB_PORT=3306
DB_USER=bk
DB_PASSWORD=bk
DB_NAME=hos

# ── Connection Pool Settings ─────────────────────────────────────────────────
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# ── Query Behavior ───────────────────────────────────────────────────────────
# false (ค่าเริ่มต้น): ดึงเฉพาะข้อมูลผู้ป่วยของวันนี้ (CURDATE())
# true: หากวันนี้ยังไม่มีข้อมูล จะดึงข้อมูลย้อนหลังล่าสุดในฐานข้อมูลมาแสดง (สำหรับการทดสอบ)
ENABLE_DATE_FALLBACK=false
