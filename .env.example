# ══════════════════════════════════════════════════════
# RTSAS Environment Variables — copy to .env and fill in
# ══════════════════════════════════════════════════════

# ── JWT ──────────────────────────────────────────────
# เปลี่ยน secret ก่อน deploy จริง!
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY_rtsas_secret_2026
JWT_EXPIRE_HOURS=8   # 8 ชั่วโมง = 1 กะ

# ── Auth DB (MySQL inside Docker) ────────────────────
AUTH_DB_ROOT_PASSWORD=rtsas_root_secure
AUTH_DB_PASSWORD=rtsas_secure

# ── HOSxP MySQL (LAN, outside Docker) ───────────────
DB_HOST=192.168.2.230
DB_PORT=3306
DB_USER=bk
DB_PASSWORD=bk
DB_NAME=hos
